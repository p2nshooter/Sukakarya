# Supabase — Project Settings → API in your Supabase dashboard.
# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, bypasses Row Level Security. Never prefix with NEXT_PUBLIC_
# and never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=
