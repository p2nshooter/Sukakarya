{
  "name": "app-desa",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise dynamic CMS for Indonesian village (desa) official websites. Multi-tenant, no hardcoded village.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply app-desa-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply app-desa-db --remote",
    "db:seed:local": "wrangler d1 execute app-desa-db --local --file=./db/seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute app-desa-db --remote --file=./db/seed/seed.sql",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "15.5.22",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@opennextjs/cloudflare": "^1.3.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.86.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "@node-minify/core": {
      "glob": "^13.0.6",
      "minimatch": "^10.2.6"
    }
  }
}
