{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["@cloudflare/workers-types"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "cloudflare-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  // `apps/*` are separate Workers with their own tsconfig and their own CI
  // typecheck. They run on the Workers runtime with no DOM, so type-checking
  // them under this project's `lib: ["dom", ...]` resolves globals like
  // `Response` to the browser declarations and reports errors that do not
  // exist where the code actually runs.
  "exclude": ["node_modules", ".open-next", ".next", "apps"]
}
